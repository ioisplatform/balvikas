rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // Health / connection check collection
    match /test/{testId} {
      allow read, write: if true;
    }

    // Global System Settings (UPI, WhatsApp, notices)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Registered Student Members
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }
  }
}
